# Tailscale Serve Login-Namen; durch die tatsächlichen Werte außerhalb des Repositories ersetzen.
TAILSCALE_RICO_LOGIN=rico@example.invalid
TAILSCALE_SECOND_USER_LOGIN=second@example.invalid

# Pfad zur lokalen SQLite-Datei; Verzeichnis vorher anlegen.
DATABASE_PATH=./local.sqlite

# Private HTTPS-Origin über Tailscale Serve, die Schreibzugriffe erwarten.
APP_ORIGIN=https://ygh.example.ts.net
